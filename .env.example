# Copy to .env and fill in. NEVER commit .env: this repository is public.

# --- Database (docker compose uses these to build DATABASE_URL for the containers) ---
POSTGRES_USER=hikaya
POSTGRES_PASSWORD=hikaya
POSTGRES_DB=hikaya
# For running the API directly on your machine instead of in Docker:
DATABASE_URL=postgresql+asyncpg://hikaya:hikaya@localhost:5432/hikaya

# --- App ---
ENV=development
MEDIA_DIR=./data/media
CORS_ORIGINS=["http://localhost:5173"]
# Sign-in uses an httpOnly cookie. Set COOKIE_SECURE=true when the site is served over HTTPS.
COOKIE_SECURE=false
SESSION_TTL_DAYS=7

# --- Staff accounts, created when the API starts (needs both an email and a password of 8+ characters) ---
# An existing account keeps its password. Choose your own passwords; never reuse real ones in a public repo.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_REVIEWER_EMAIL=
SEED_REVIEWER_PASSWORD=

# --- Which provider does which step (each can be switched without code changes) ---
# "fake" gives readable, deterministic results with no keys and no cost. The real
# providers arrive with tickets #12 (Azure language model), #13 (transcription) and
# #14 (narration); until then only "fake" works for these three.
STT_PROVIDER=fake            # fake | elevenlabs | azure
TTS_PROVIDER=fake            # fake | elevenlabs | azure
LLM_PROVIDER=fake            # fake | azure
VIDEO_PROVIDER=fal           # fal | higgsfield | gemini | custom

# --- Safety switches ---
# Live AI calls are off by default. The demo plays pre-generated results.
LIVE_AI_ENABLED=false
ENABLE_AI_VIDEO=false
# Card-paid spending caps in USD. Paid calls are refused when a cap would be exceeded.
SPEND_CAP_USD_TOTAL=25
SPEND_CAP_USD_DAILY=10
# Azure is paid from its own budget.
SPEND_CAP_USD_AZURE=50

# --- ElevenLabs (speech to text, narration, voice cloning) ---
ELEVENLABS_API_KEY=

# --- Azure (language model, fallback speech) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# --- Video providers (only the one you pick needs a key) ---
FAL_KEY=
HIGGSFIELD_KEY_ID=
HIGGSFIELD_KEY_SECRET=
GEMINI_API_KEY=

# Staff voice cloning: fake for rehearsals; elevenlabs requires live AI and consent.
VOICE_CLONE_PROVIDER=fake
VOICE_CLONE_ESTIMATE_USD=1.0

# Conservative total reservation for one video job, configured for the chosen model.
VIDEO_ESTIMATE_USD=1.0
VIDEO_POLL_SECONDS=3
# VIDEO_PROVIDER=fake and ENABLE_AI_VIDEO=true rehearse the staff flow without paid calls.

# Google Veo GA runs through Google Cloud. Gemini API Veo previews retired 2026-10-22.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_ACCESS_TOKEN=
# Trusted Higgsfield upload/result domains; extend only for hosts returned by your account.
HIGGSFIELD_MEDIA_HOSTS=["higgsfield.ai","amazonaws.com","cloudfront.net","storage.googleapis.com"]
# A Cog predictor accepting prompt, image, aspect_ratio and seed; returns MP4 data or same-origin URL.
CUSTOM_VIDEO_ENDPOINT=
CUSTOM_VIDEO_TOKEN=
CUSTOM_VIDEO_ESTIMATE_USD=0
